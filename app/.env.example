# TeachMate：Pi Agent 单一多模态模型配置
PORT=8004
FILE_SERVER_PORT=8002
FILE_SERVER_URL=http://localhost:8002
# Desktop host overrides these paths into the OS user-data directory.
# UPLOADS_DIR=
# LOGS_DIR=
# KB_DIR=
# WEB_DIST_DIR=
SQLITE_DB_PATH=data/teachmate.sqlite

# 图片理解通过 Pi Agent Runtime；文字评分/反馈使用同一 DeepSeek 官方 Chat Completions 链路
PI_RUNTIME=pi
PI_MODEL_PROVIDER=deepseek
PI_MODEL_ID=deepseek-flash
PI_MODEL_API_KEY=
PI_MODEL_BASE_URL=https://api.deepseek.com
PI_MODEL_SUPPORTS_IMAGES=true
PI_MODEL_TIMEOUT_MS=180000
PI_MODEL_MAX_IMAGES_PER_RUN=8
# DeepSeek thinking mode for text grading/feedback: none, low, medium, high, max
PI_MODEL_REASONING_EFFORT=high
